{
  "title": "Голоса детекторов",
  "uid": "trading-votes",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "",
  "time": { "from": "2020-01-01T00:00:00Z", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "symbol",
        "type": "query",
        "datasource": { "type": "mysql", "uid": "trading-mysql" },
        "query": "SELECT DISTINCT symbol FROM candles",
        "refresh": 1,
        "current": { "text": "btc.v", "value": "btc.v" }
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "Сделок закрыто",
      "type": "stat",
      "datasource": { "type": "mysql", "uid": "trading-mysql" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "refId": "A", "format": "table", "rawQuery": true,
        "rawSql": "SELECT COUNT(*) AS value FROM trades WHERE symbol = '$symbol' AND exit_time IS NOT NULL"
      }]
    },
    {
      "id": 11,
      "title": "Win rate, %",
      "type": "stat",
      "datasource": { "type": "mysql", "uid": "trading-mysql" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "refId": "A", "format": "table", "rawQuery": true,
        "rawSql": "SELECT ROUND(AVG(profit_pct > 0) * 100, 1) AS value FROM trades WHERE symbol = '$symbol' AND exit_time IS NOT NULL"
      }]
    },
    {
      "id": 12,
      "title": "Средняя сделка, %",
      "type": "stat",
      "datasource": { "type": "mysql", "uid": "trading-mysql" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "refId": "A", "format": "table", "rawQuery": true,
        "rawSql": "SELECT ROUND(AVG(profit_pct), 2) AS value FROM trades WHERE symbol = '$symbol' AND exit_time IS NOT NULL"
      }]
    },
    {
      "id": 13,
      "title": "Итог equity, $",
      "type": "stat",
      "datasource": { "type": "mysql", "uid": "trading-mysql" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "refId": "A", "format": "table", "rawQuery": true,
        "rawSql": "SELECT ROUND(equity) AS value FROM equity WHERE symbol = '$symbol' ORDER BY ts DESC LIMIT 1"
      }]
    },
    {
      "id": 1,
      "title": "Цена $symbol — зелёные точки входы, красные выходы",
      "type": "timeseries",
      "datasource": { "type": "mysql", "uid": "trading-mysql" },
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 0 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Вход" },
            "properties": [
              { "id": "custom.drawStyle", "value": "points" },
              { "id": "custom.pointSize", "value": 10 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Выход" },
            "properties": [
              { "id": "custom.drawStyle", "value": "points" },
              { "id": "custom.pointSize", "value": 10 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT ts AS time, close AS 'Цена' FROM candles WHERE symbol = '$symbol' AND $__timeFilter(ts) ORDER BY ts"
        },
        {
          "refId": "B", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT entry_time AS time, entry_price AS 'Вход' FROM trades WHERE symbol = '$symbol' AND $__timeFilter(entry_time) ORDER BY entry_time"
        },
        {
          "refId": "C", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT exit_time AS time, exit_price AS 'Выход' FROM trades WHERE symbol = '$symbol' AND exit_time IS NOT NULL AND $__timeFilter(exit_time) ORDER BY exit_time"
        }
      ]
    },
    {
      "id": 2,
      "title": "Голос ансамбля: выше зелёной линии — покупка, ниже красной — выход",
      "type": "timeseries",
      "datasource": { "type": "mysql", "uid": "trading-mysql" },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 7 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Порог входа" },
            "properties": [
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Порог выхода" },
            "properties": [
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT ts AS time, total AS 'Голос' FROM ensemble_score WHERE symbol = '$symbol' AND $__timeFilter(ts) ORDER BY ts"
        },
        {
          "refId": "B", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT ts AS time, 1.3 AS 'Порог входа' FROM ensemble_score WHERE symbol = '$symbol' AND $__timeFilter(ts) ORDER BY ts"
        },
        {
          "refId": "C", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT ts AS time, -1.0 AS 'Порог выхода' FROM ensemble_score WHERE symbol = '$symbol' AND $__timeFilter(ts) ORDER BY ts"
        }
      ]
    },
    {
      "id": 4,
      "title": "Equity стратегии vs Buy&Hold (старт $10 000)",
      "type": "timeseries",
      "datasource": { "type": "mysql", "uid": "trading-mysql" },
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT ts AS time, equity AS 'Стратегия' FROM equity WHERE symbol = '$symbol' AND $__timeFilter(ts) ORDER BY ts"
        },
        {
          "refId": "B", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT ts AS time, close / (SELECT close FROM candles WHERE symbol = '$symbol' ORDER BY ts LIMIT 1) * 10000 AS 'Buy&Hold' FROM candles WHERE symbol = '$symbol' AND $__timeFilter(ts) ORDER BY ts"
        }
      ]
    },
    {
      "id": 7,
      "title": "P&L по причинам выхода",
      "type": "table",
      "datasource": { "type": "mysql", "uid": "trading-mysql" },
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 7 },
      "targets": [{
        "refId": "A", "format": "table", "rawQuery": true,
        "rawSql": "SELECT exit_reason AS 'Причина', COUNT(*) AS 'Сделок', ROUND(AVG(profit_pct),2) AS 'Средняя, %', ROUND(SUM(profit_pct),1) AS 'Сумма, %' FROM trades WHERE symbol = '$symbol' AND exit_time IS NOT NULL GROUP BY exit_reason"
      }]
    },
    {
      "id": 8,
      "title": "Последние сделки",
      "type": "table",
      "datasource": { "type": "mysql", "uid": "trading-mysql" },
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 7 },
      "targets": [{
        "refId": "A", "format": "table", "rawQuery": true,
        "rawSql": "SELECT entry_time AS 'Вход', exit_time AS 'Выход', ROUND(entry_price,2) AS 'Цена входа', ROUND(exit_price,2) AS 'Цена выхода', ROUND(profit_pct,2) AS 'P&L, %', exit_reason AS 'Причина' FROM trades WHERE symbol = '$symbol' ORDER BY entry_time DESC LIMIT 15"
      }]
    }
  ]
}
